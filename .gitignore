# ---- Build artifacts ----
/build/
compile_commands.json

# ---- Python bytecode and caches ----
**/__pycache__/
*.py[cod]
.pytest_cache/
.cache/

# ---- OS and editor cruft ----
.DS_Store
.vscode/
.claude/

# ---- Relocated findings (kept local, never pushed): supporting + unrelated ----
/_archive/

# ---- Deferred service-layer scaffold (kept local, not pushed) ----
# .github/ (CI) and the Makefile/scripts entrypoint are now TRACKED on trunk so
# CI and every later agent share one build-and-test entrypoint. Only the in-progress
# infra/ runtime scaffold stays local until it is declared in scope.
/infra/

# ---- Datasets: contents kept local; only the provenance manifest is tracked ----
/data/*
!/data/README.md

# ---- Local result / output / run trees (kept local, never pushed) ----
/results/
/outputs/
/runs/

# ---- Local status reports, logs, working notes, and archived program records ----
/summary.md
/log.md
/architecture_review.md
/repo_resume.md
/api_prep.md
/git_summary.md
/documents/
/CLAUDE.md
