# ---- Build artifacts ----
/build/
compile_commands.json

# ---- Python bytecode and caches ----
**/__pycache__/
*.py[cod]
.pytest_cache/
.cache/

# ---- OS and editor cruft ----
.DS_Store
.vscode/
.claude/

# ---- Local result / output / run trees (kept local, never pushed) ----
/results/
/outputs/
/runs/

# ---- viz raw run artifacts (regenerable; figures under viz/figures are kept) ----
/viz/artifacts/

# ---- DNS datasets (bulk data stays local; only the manifest .md files are tracked) ----
/DNS_data/*
!/DNS_data/README.md
!/DNS_data/*.md

# ---- Local-only agent instructions and archived program records (never pushed) ----
/CLAUDE.md
/_archive/
/infra/

# ---- Local status reports, logs, working notes, and archived program records ----
/summary.md
/log.md
/architecture_review.md
/repo_resume.md
/api_prep.md
/git_summary.md
/documents/
# ---- Legacy root-level solver duplicates (superseded by core/, incompressible/,
# ---- compressible/, dbns/; kept on disk for private reference, never tracked) ----
/include/
/src/
